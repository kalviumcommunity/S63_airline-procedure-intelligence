# ==============================================================================
# SkyOps Intelligence - Unified Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN LOCAL CREDENTIALS
# DO NOT COMMIT ACTUAL API KEYS OR PASSWORDS TO SOURCE CONTROL
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=True

# ------------------------------------------------------------------------------
# 2. BACKEND API SERVICE (FastAPI)
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
PROJECT_NAME="SkyOps Intelligence Backend"
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ------------------------------------------------------------------------------
# 3. LLM & EMBEDDING PROVIDERS (Safe dummy values for template)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-placeholder-openai-api-key-do-not-commit
ANTHROPIC_API_KEY=sk-ant-placeholder-anthropic-key-do-not-commit
DEFAULT_LLM_MODEL=claude-3-5-sonnet-20241022
DEFAULT_EMBEDDING_MODEL=text-embedding-3-large
LLM_TEMPERATURE=0.0

# ------------------------------------------------------------------------------
# 4. VECTOR DATABASE & METADATA STORE
# ------------------------------------------------------------------------------
VECTOR_DB_TYPE=qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=placeholder-qdrant-key

# Database Connection (PostgreSQL with pgvector)
POSTGRES_USER=skyops_user
POSTGRES_PASSWORD=placeholder_secure_password
POSTGRES_DB=skyops_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://skyops_user:placeholder_secure_password@localhost:5432/skyops_db

# ------------------------------------------------------------------------------
# 5. FRONTEND (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_DEFAULT_STATION=KORD
NEXT_PUBLIC_DEFAULT_FLEET=A321neo

