# Backend Environment Variable Configuration Template
# Copy to backend/.env for local service development

PROJECT_NAME="SkyOps Intelligence Backend"
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Server Bindings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# LLM Providers (Mock or actual keys; keep placeholders in git)
OPENAI_API_KEY=sk-placeholder-openai-api-key
ANTHROPIC_API_KEY=sk-placeholder-anthropic-key
DEFAULT_LLM_MODEL=claude-3-5-sonnet-20241022
DEFAULT_EMBEDDING_MODEL=text-embedding-3-large
LLM_TEMPERATURE=0.0

# Vector Database (Qdrant or PgVector)
VECTOR_DB_TYPE=qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=placeholder-qdrant-key
DATABASE_URL=postgresql+asyncpg://skyops_user:placeholder_password@localhost:5432/skyops_db

